{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "ef1e5de7-2923-472d-9ad1-1132af082c12","database_name": "my" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b9417f871bcd4d4f9ad2c193a1fde000" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
